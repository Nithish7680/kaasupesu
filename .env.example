# Copy this file to .env and fill in the keys. Never commit .env.
# Without keys the prototype runs in demo mode: browser speech recognition, browser voices and built-in rules.

# OpenAI: reads the owner's note and labels the buyer's reply (gpt-6-luna), and speaks KaasuPesu's lines (gpt-4o-mini-tts).
OPENAI_API_KEY=

# Wispr Flow developer API key (platform.wisprflow.ai): turns the owner's and the buyer's speech into text.
# Used only when OPENAI_API_KEY is set too: Wispr may write Tamil or Devanagari, and GPT reads those.
WISPR_API_KEY=

# Local port (the server listens on 127.0.0.1 only).
PORT=8787
