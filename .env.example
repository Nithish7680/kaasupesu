# Copy this file to .env and fill in the keys, then run npm start. Never commit .env.
# Every value is optional: with none, the app runs with browser speech recognition, browser voices and built-in rules.
# docker compose up never uses this file: the container always runs without keys.

# OpenAI: reads the owner's note and labels the buyer's reply (gpt-6-luna), and speaks KaasuPesu's lines (gpt-4o-mini-tts).
OPENAI_API_KEY=

# Wispr Flow developer API key (platform.wisprflow.ai; Wispr must approve access): turns speech into text.
# Used only when OPENAI_API_KEY is set too: Wispr may write Tamil or Devanagari, and GPT reads those.
# Set it only to a working key: with both keys set, every recording goes to Wispr.
WISPR_API_KEY=

# Where the server listens. npm start uses 127.0.0.1; the Docker image sets 0.0.0.0 itself.
HOST=127.0.0.1
PORT=8787

# npm run smoke starts its own server on this port. It is read from the shell, not from this file:
# SMOKE_PORT=8797 npm run smoke
