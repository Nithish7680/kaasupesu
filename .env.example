# Copy this file to .env and fill in the keys. Never commit .env.
# Without keys the prototype runs in demo mode: typed text, browser voices and built-in rules.

# Sarvam AI: speech-to-text (saaras:v4) and text-to-speech (bulbul:v3). https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Anthropic: reads the owner's note and labels the buyer's reply (claude-opus-5-5).
ANTHROPIC_API_KEY=

# Local port (the server listens on 127.0.0.1 only).
PORT=8787
